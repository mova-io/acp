{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "cacheName": {"type": "string", "defaultValue": "acp-managed-redis"},
    "location": {"type": "string", "defaultValue": "eastus2"}
  },
  "resources": [
    {
      "type": "Microsoft.Cache/redisEnterprise",
      "apiVersion": "2025-07-01",
      "name": "[parameters('cacheName')]",
      "location": "[parameters('location')]",
      "sku": {"name": "Balanced_B0"},
      "tags": {"application": "acp", "purpose": "shared-transient-state"},
      "properties": {
        "highAvailability": "Enabled",
        "minimumTlsVersion": "1.2",
        "publicNetworkAccess": "Enabled"
      }
    },
    {
      "type": "Microsoft.Cache/redisEnterprise/databases",
      "apiVersion": "2025-07-01",
      "name": "[concat(parameters('cacheName'), '/default')]",
      "dependsOn": ["[resourceId('Microsoft.Cache/redisEnterprise', parameters('cacheName'))]"],
      "properties": {
        "clientProtocol": "Encrypted",
        "accessKeysAuthentication": "Enabled",
        "port": 10000,
        "clusteringPolicy": "NoCluster",
        "evictionPolicy": "NoEviction",
        "persistence": {"aofEnabled": false, "rdbEnabled": false}
      }
    }
  ]
}
