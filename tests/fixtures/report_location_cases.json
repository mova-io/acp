    {"name": "pdf unknown machine locator: the page names the place, raw is kept (not glued into the label)", "fmt": "pdf", "location": "/Document/Sect[2]/Figure", "page": 7,
     "expect": {"label": "Page 7", "kind": "page", "page": 7, "slide": null, "sheet": null, "cell": null, "objectId": null, "raw": "/Document/Sect[2]/Figure"}},
    {"name": "word paragraph never sets a page", "fmt": "docx", "location": "docx:paragraph:14", "page": 5,
