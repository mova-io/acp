{
  "_comment": "Contract 1 (report follow-up): ONE table for both parsers. api/report_location.py parse_location (tests/test_report_location.py) and frontend/src/reportEvidence.js locationOf (frontend/src/reportLocation.test.js) must produce exactly `expect` for every case. Strings are the detectors' own formats (engine/office-analysers/*/Helpers/LocationHelper.cs, api/proposals.py, api/remediate_pdf.py, api/pdf_structure_repairs.py). Word paragraph/table indices and pptx:slide:{i} are 0-based in the analyser; labels are 1-based.",
  "cases": [
    {"name": "nothing recorded", "fmt": "docx", "location": null, "page": null, "expect": null},
    {"name": "pdf page only", "fmt": "pdf", "location": null, "page": 3,
     "expect": {"label": "Page 3", "kind": "page", "page": 3, "slide": null, "sheet": null, "cell": null, "objectId": null, "raw": null}},
    {"name": "pdf figure with page", "fmt": "pdf", "location": "pdf:fig:3:0", "page": 3,
     "expect": {"label": "Page 3 · figure 1", "kind": "object", "page": 3, "slide": null, "sheet": null, "cell": null, "objectId": "figure:3:0", "raw": "pdf:fig:3:0"}},
    {"name": "pdf figure, page only in the locator", "fmt": "pdf", "location": "pdf:fig:2:4", "page": null,
     "expect": {"label": "Page 2 · figure 5", "kind": "object", "page": 2, "slide": null, "sheet": null, "cell": null, "objectId": "figure:2:4", "raw": "pdf:fig:2:4"}},
    {"name": "pdf figure with no page anywhere", "fmt": "pdf", "location": "pdf:fig:?:0", "page": null,
     "expect": {"label": "Figure 1 (page not recorded)", "kind": "object", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": "figure:?:0", "raw": "pdf:fig:?:0"}},
    {"name": "pdf form field", "fmt": "pdf", "location": "pdf:field:1:2", "page": 1,
     "expect": {"label": "Page 1 · form field 3", "kind": "object", "page": 1, "slide": null, "sheet": null, "cell": null, "objectId": "field:1:2", "raw": "pdf:field:1:2"}},
    {"name": "pdf structure element", "fmt": "pdf", "location": "pdf:struct:0.3.1:ab12", "page": 4,
     "expect": {"label": "Page 4 · structure element 0.3.1", "kind": "object", "page": 4, "slide": null, "sheet": null, "cell": null, "objectId": "struct:0.3.1", "raw": "pdf:struct:0.3.1:ab12"}},
    {"name": "pdf unknown locator keeps raw", "fmt": "pdf", "location": "/Document/Sect[2]/Figure", "page": 7,
     "expect": {"label": "Page 7 · /Document/Sect[2]/Figure", "kind": "page", "page": 7, "slide": null, "sheet": null, "cell": null, "objectId": null, "raw": "/Document/Sect[2]/Figure"}},
    {"name": "word paragraph never sets a page", "fmt": "docx", "location": "docx:paragraph:14", "page": 5,
     "expect": {"label": "Paragraph 15", "kind": "paragraph", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": "paragraph:14", "raw": "docx:paragraph:14"}},
    {"name": "word drawing in a paragraph", "fmt": "docx", "location": "docx:drawing:7:paragraph:0", "page": null,
     "expect": {"label": "Image (drawing id 7) · paragraph 1", "kind": "object", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": "drawing:7", "raw": "docx:drawing:7:paragraph:0"}},
    {"name": "word image ordinal", "fmt": "docx", "location": "docx:image:1", "page": 1,
     "expect": {"label": "Image 1", "kind": "object", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": "image:1", "raw": "docx:image:1"}},
    {"name": "word table row", "fmt": "docx", "location": "docx:table:1:row:0", "page": null,
     "expect": {"label": "Table 2 · row 1", "kind": "object", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": "table:1", "raw": "docx:table:1:row:0"}},
    {"name": "word hyperlink", "fmt": "docx", "location": "docx:hyperlink:paragraph:114:url:https://example.org/a:b", "page": null,
     "expect": {"label": "Link in paragraph 115", "kind": "paragraph", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": "paragraph:114", "raw": "docx:hyperlink:paragraph:114:url:https://example.org/a:b"}},
    {"name": "word document property", "fmt": "docx", "location": "docx:document-properties:language", "page": null,
     "expect": {"label": "Document-wide (language property)", "kind": "document", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": null, "raw": "docx:document-properties:language"}},
    {"name": "word page with no locator is not a location", "fmt": "docx", "location": null, "page": 2, "expect": null},
    {"name": "pptx slide from the 1-based page", "fmt": "pptx", "location": "pptx:slide:1", "page": 2,
     "expect": {"label": "Slide 2", "kind": "slide", "page": 2, "slide": 2, "sheet": null, "cell": null, "objectId": null, "raw": "pptx:slide:1"}},
    {"name": "pptx slide from the 0-based string only", "fmt": "pptx", "location": "pptx:slide:0", "page": null,
     "expect": {"label": "Slide 1", "kind": "slide", "page": 1, "slide": 1, "sheet": null, "cell": null, "objectId": null, "raw": "pptx:slide:0"}},
    {"name": "pptx shape", "fmt": "pptx", "location": "pptx:slide:1:element:5", "page": 2,
     "expect": {"label": "Slide 2 · shape 5", "kind": "object", "page": 2, "slide": 2, "sheet": null, "cell": null, "objectId": "shape:5", "raw": "pptx:slide:1:element:5"}},
    {"name": "pptx table", "fmt": "pptx", "location": "pptx:slide:3:table:0", "page": null,
     "expect": {"label": "Slide 4 · table 1", "kind": "object", "page": 4, "slide": 4, "sheet": null, "cell": null, "objectId": "table:0", "raw": "pptx:slide:3:table:0"}},
    {"name": "pptx page only", "fmt": "pptx", "location": null, "page": 3,
     "expect": {"label": "Slide 3", "kind": "slide", "page": 3, "slide": 3, "sheet": null, "cell": null, "objectId": null, "raw": null}},
    {"name": "xlsx sheet", "fmt": "xlsx", "location": "xlsx:sheet:Budget", "page": null,
     "expect": {"label": "Sheet Budget", "kind": "sheet", "page": null, "slide": null, "sheet": "Budget", "cell": null, "objectId": null, "raw": "xlsx:sheet:Budget"}},
    {"name": "xlsx cell", "fmt": "xlsx", "location": "xlsx:sheet:Budget 2026:cell:B3", "page": 1,
     "expect": {"label": "Sheet Budget 2026 · cell B3", "kind": "cell", "page": null, "slide": null, "sheet": "Budget 2026", "cell": "B3", "objectId": null, "raw": "xlsx:sheet:Budget 2026:cell:B3"}},
    {"name": "xlsx drawing", "fmt": "xlsx", "location": "xlsx:sheet:Q1:drawing:4", "page": null,
     "expect": {"label": "Sheet Q1 · drawing 4", "kind": "object", "page": null, "slide": null, "sheet": "Q1", "cell": null, "objectId": "drawing:4", "raw": "xlsx:sheet:Q1:drawing:4"}},
    {"name": "xlsx column", "fmt": "xlsx", "location": "xlsx:sheet:Q1:col:3", "page": null,
     "expect": {"label": "Sheet Q1 · column 3", "kind": "object", "page": null, "slide": null, "sheet": "Q1", "cell": null, "objectId": "column:3", "raw": "xlsx:sheet:Q1:col:3"}},
    {"name": "xlsx document", "fmt": "xlsx", "location": "xlsx:document", "page": null,
     "expect": {"label": "Document-wide", "kind": "document", "page": null, "slide": null, "sheet": null, "cell": null, "objectId": null, "raw": "xlsx:document"}},
    {"name": "legacy A1 reference", "fmt": null, "location": "Budget!B4", "page": null,
     "expect": {"label": "Sheet Budget · cell B4", "kind": "cell", "page": null, "slide": null, "sheet": "Budget", "cell": "B4", "objectId": null, "raw": "Budget!B4"}},
    {"name": "unknown format keeps raw", "fmt": null, "location": "word/header1.xml#Picture 1", "page": null,
     "expect": {"label": "word/header1.xml#Picture 1", "kind": null, "page": null, "slide": null, "sheet": null, "cell": null, "objectId": null, "raw": "word/header1.xml#Picture 1"}},
    {"name": "a stated page beside its own label", "fmt": "pptx", "location": "Slide 3", "page": 3,
     "expect": {"label": "Slide 3", "kind": "slide", "page": 3, "slide": 3, "sheet": null, "cell": null, "objectId": null, "raw": "Slide 3"}}
  ]
}
