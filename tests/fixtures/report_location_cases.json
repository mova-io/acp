     "expect": {"label": "/Document/Sect[2]/Figure", "kind": null, "page": null, "slide": null, "sheet": null, "cell": null, "objectId": null, "raw": "/Document/Sect[2]/Figure"}},
    {"name": "unknown HUMAN text beside a page stays in the label", "fmt": "pdf", "location": "caption area", "page": 2,
